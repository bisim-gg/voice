{
  "name": "@bisim/voice",
  "version": "0.1.0",
  "description": "Voice for Bisim bots: join voice channels, play and receive audio, written the @discordjs/voice way",
  "license": "MIT",
  "author": "Bisim",
  "homepage": "https://github.com/bisim-gg/voice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bisim-gg/voice.git"
  },
  "bugs": {
    "url": "https://github.com/bisim-gg/voice/issues"
  },
  "keywords": [
    "bisim",
    "bot",
    "voice",
    "audio",
    "livekit",
    "bisim.js",
    "discordjs-voice"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:build": "typedoc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@livekit/rtc-node": "^1.2.0",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
